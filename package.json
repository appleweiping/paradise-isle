{
  "name": "paradise-isle",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "An island life-sim for the browser: farm, raise animals, fish, fight off wild beasts, dress up and visit neighbours.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "server": "node server/index.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
